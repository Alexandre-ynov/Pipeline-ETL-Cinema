{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TMDB discover movie response",
    "type": "object",
    "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "results": {
            "type": "array",
            "items": { "$ref": "#/$defs/movie" }
        },
        "total_pages": { "type": "integer", "minimum": 0 },
        "total_results": { "type": "integer", "minimum": 0 },
        "pages_fetched": { "type": "integer", "minimum": 1 },
        "api_total_pages": { "type": "integer", "minimum": 1 },
        "has_more_pages": { "type": "boolean" }
    },
    "required": [
        "page",
        "results",
        "total_pages",
        "total_results",
        "pages_fetched",
        "api_total_pages",
        "has_more_pages"
    ],
    "additionalProperties": false,
    "$defs": {
        "movie": {
            "type": "object",
            "properties": {
                "adult": { "type": "boolean" },
                "backdrop_path": { "type": ["string", "null"] },
                "genre_ids": {
                    "type": "array",
                    "items": { "type": "integer" }
                },
                "id": { "type": "integer" },
                "title": { "type": "string", "minLength": 1 },
                "original_language": { "type": "string" },
                "original_title": { "type": "string" },
                "overview": { "type": "string" },
                "popularity": { "type": "number" },
                "poster_path": { "type": ["string", "null"] },
                "release_date": { "type": "string" },
                "softcore": { "type": "boolean" },
                "video": { "type": "boolean" },
                "vote_average": { "type": "number", "minimum": 0 },
                "vote_count": { "type": "integer", "minimum": 0 }
            },
            "required": [
                "genre_ids",
                "id",
                "title",
                "release_date",
                "vote_average",
                "vote_count"
            ],
            "additionalProperties": false
        }
    }
}